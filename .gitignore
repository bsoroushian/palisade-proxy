.gradle-wrapper/

# JetBrains IntelliJ IDEA configuration
.idea/
*.iml
*.iws

# Visual Studio Code configuration
.vscode/
*.code-workspace

# Python virtual environment, artifacts, and testing cache
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.pytest_cache**/

# OS / Environment variables containing keys/passwords
.env
*.local
.DS_Store
