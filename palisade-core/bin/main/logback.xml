<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- Custom pattern utilizing Logback colors and highlights -->
            <pattern>%d{YYYY-MM-dd HH:mm:ss.SSS} %highlight(%-5level) %cyan(%logger{36}) - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>

    <!-- Keeps Ktor noise manageable while letting your custom loader alerts pass through -->
    <logger name="io.ktor" level="INFO"/>
    <logger name="PalisadeConfigLoader" level="WARN"/>
</configuration>
